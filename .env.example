# Public content is available from the local fallback when these are omitted.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for the admin area and server-side content mutations.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-strong-local-admin-password
